[global_config]
  enabled_plugins = Logger, LaunchpadBugURLHandler, LaunchpadCodeURLHandler, APTURLHandler
[keybindings]
[profiles]
  [[default]]
    icon_bell = False
    background_darkness = 0.9
    background_type = transparent
    background_color = "#000000"
    foreground_color = "#ffffff"
    scrollbar_position = hidden
    scrollback_infinite = True
    palette = "#282828:#cc241d:#98971a:#d79921:#458588:#b16286:#689d6a:#a89984:#928374:#fb4934:#b8bb26:#fabd2f:#83a598:#d3869b:#8ec07c:#ebdbb2"
    # use_theme_colors would inherit the GTK theme and render light-on-white.
    use_theme_colors = False
    # Kali's terminal font (fonts-firacode). Falls back to Monospace if absent.
    use_system_font = False
    font = Fira Code Medium 10
    copy_on_selection = True
    title_hide_sizetext = True
    title_transmit_fg_color = "#c64600"
    title_transmit_bg_color = "#000000"
    title_receive_fg_color = "#000000"
    title_receive_bg_color = "#c64600"
    title_inactive_fg_color = "#c64600"
    title_inactive_bg_color = "#241f31"
    title_font = Sans Bold 10
[layouts]
  [[default]]
    [[[window0]]]
      type = Window
      parent = ""
    [[[child1]]]
      type = Terminal
      parent = window0
[plugins]
